# Template for the production-mode stack's private `.env.prod` (git-ignored).
#
# scripts/prod.sh (`make prod`) copies this file to `.env.prod` on first run
# (mode 600) and replaces every @hex32@ / @hex16@ / @b64url32@ marker with a
# random value generated inside a container. It never overwrites an existing
# `.env.prod`, so database passwords and key rings stay valid for existing
# volumes. The defaults below run the production build locally with no external
# accounts: https://bytecore.localhost, a generated local CA, emails captured by
# Mailpit, no real keys and no real data. For a real host, change PROD_HOST, the
# TLS mode and SMTP (see docs/production-setup.md). Startup validates the file and
# names invalid variables without printing values.

# --- Public origin ------------------------------------------------------------
# DNS name browsers use. Storefront: https://PROD_HOST (or :PROD_HTTPS_PORT);
# Kratos, Hydra and the login bridge use the extra HTTPS ports on the same host.
PROD_HOST=bytecore.localhost
PROD_HTTP_PORT=80
PROD_HTTPS_PORT=443
PROD_KRATOS_PORT=9433
PROD_HYDRA_PORT=9444
PROD_BRIDGE_PORT=9446
# Host interface for the published edge ports (0.0.0.0 on a real server).
PROD_BIND=127.0.0.1

# --- TLS ----------------------------------------------------------------------
# acme       public certificate from Let's Encrypt; PROD_HOST must be a real DNS
#            name pointing here with ports 80/443 reachable from the internet.
# files      operator certificate: PROD_TLS_CERT_FILE / PROD_TLS_KEY_FILE
#            (full chain + key, absolute paths outside Git).
# selfsigned local CA generated under PROD_SECRETS_DIR/tls (trust tls/ca.crt);
#            default for local runs; browsers must trust tls/ca.crt.
PROD_TLS_MODE=selfsigned
PROD_ACME_EMAIL=
PROD_TLS_CERT_FILE=
PROD_TLS_KEY_FILE=
# Strict-Transport-Security max-age in seconds.
PROD_HSTS_MAX_AGE=31536000

# --- Persistent private material ----------------------------------------------
# Postgres storage key (pgdata.key) and internal TLS material (tls/). Relative
# paths are resolved from the repository root. Keep outside the encrypted
# volume, back it up separately, never commit it.
PROD_SECRETS_DIR=infrastructure/prod/secrets
# Internal network; Spring trusts X-Forwarded-For only from the Hive Router's
# fixed address. Change both together if the subnet collides.
PROD_SUBNET=172.28.92.0/24
PROD_HIVE_IP=172.28.92.40

# --- Email (SMTP relay for Kratos, oauth-service and Spring) -------------------
# Real delivery needs a relay that accepts mail for SMTP_FROM's domain. Set
# exactly one of SMTP_STARTTLS / SMTP_IMPLICIT_TLS to true for remote relays.
# SMTP_HOST=mailpit starts a local capture-only Mailpit (UI on
# 127.0.0.1:PROD_MAILPIT_UI_PORT) for sandbox testing; it delivers nothing.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_IMPLICIT_TLS=false
SMTP_FROM=no-reply@bytecore.localhost
# Inbox receiving contact-form messages.
SUPPORT_MAIL_TO=support@bytecore.localhost
PROD_MAILPIT_UI_PORT=18025

# --- Payments: Stripe sandbox only (test-mode keys) ----------------------------
# Live keys (sk_live_/pk_live_) are rejected. Blank keys disable card payment
# (browsing still works). Blank keys are taken from the Git-ignored .env.stripe
# (see .env.stripe.example) or, failing that, the dev .env; a blank STRIPE_WEBHOOK_SECRET is then fetched
# automatically and a stripe-listener container forwards the webhooks. For a
# public host, create a Stripe dashboard (test mode) endpoint
# https://PROD_HOST/webhooks/stripe and paste its whsec_ secret here instead.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google sign-in (optional; both or neither) --------------------------------
# Authorized redirect URI on the Google OAuth client:
#   https://PROD_HOST/self-service/methods/oidc/callback/google
# Blank values are taken from the Git-ignored dev .env when it has them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Bootstrap administrator ------------------------------------------------
# Created once (email <ADMIN_USERNAME>@bytecore.ee) if absent; never reset
# afterwards. Sign in, then enroll TOTP at /admin/security before any staff
# operation. Change the password from the account page after first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=@hex16@

# --- Generated internal secrets (do not edit once data exists) -----------------
DB_USERNAME=retail
DB_PASSWORD=@hex32@

HYDRA_DB_USER=hydra
HYDRA_DB_PASSWORD=@hex32@
HYDRA_DSN=postgres://${HYDRA_DB_USER}:${HYDRA_DB_PASSWORD}@postgres:5432/hydra?sslmode=verify-full&sslrootcert=/review-certs/ca.crt
HYDRA_SYSTEM_SECRET=@hex32@
HYDRA_ADMIN_URL=http://hydra:4445
HYDRA_PUBLIC_URL=http://hydra:4444

KRATOS_DB_USER=kratos
KRATOS_DB_PASSWORD=@hex32@
KRATOS_DSN=postgres://${KRATOS_DB_USER}:${KRATOS_DB_PASSWORD}@postgres:5432/kratos?sslmode=verify-full&sslrootcert=/review-certs/ca.crt
KRATOS_SECRETS_COOKIE=@hex32@
# Kratos requires exactly 32 characters.
KRATOS_SECRETS_CIPHER=@hex16@
KRATOS_ADMIN_URL=http://kratos:4434
KRATOS_PUBLIC_URL=http://kratos:4433

PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=@hex32@
PAYMENT_DB_URL=postgres://${PAYMENT_DB_USER}:${PAYMENT_DB_PASSWORD}@postgres:5432/payment_service?sslmode=verify-full&sslrootcert=/review-certs/ca.crt
PAYMENT_INTERNAL_TOKEN=@hex32@

AUTH_MIGRATION_USER=storefront_auth_migrator
AUTH_MIGRATION_PASSWORD=@hex32@
AUTH_DB_USER=storefront_auth_runtime
AUTH_DB_PASSWORD=@hex32@
CAPTCHA_DB_USER=storefront_captcha_runtime
CAPTCHA_DB_PASSWORD=@hex32@
CAPTCHA_DATABASE_URL=postgres://${CAPTCHA_DB_USER}:${CAPTCHA_DB_PASSWORD}@postgres:5432/storefront_auth?sslmode=verify-full&sslrootcert=/review-certs/ca.crt

# Not a secret; any 22-character base64url id, fixed once the Kafka volume exists.
KAFKA_CLUSTER_ID=Ynl0ZWNvcmUtcHJvZC1rYQ

OAUTH_SERVICE_CLIENT_ID=oauth-service-internal
OAUTH_SERVICE_CLIENT_SECRET=@hex32@
BFF_CLIENT_ID=bytecore-storefront
BFF_CLIENT_SECRET=@hex32@
AUTH_BRIDGE_SECRET=@hex32@
CAPTCHA_SECRET=@hex32@
# BFF sealing key ring (base64url-encoded 32-byte keys). Rotate by adding a key
# and switching "active"; never remove a key still sealing live sessions.
AUTH_SEAL_KEYS='{"active":"v1","keys":{"v1":"@b64url32@"}}'
# Backend encryption-at-rest key ring (docs/security/encryption-at-rest.md).
APP_DATA_KEYS=v1:@b64url32@

# Required by compose.yml; compose.prod.yml sets the values derived from PROD_HOST.
KRATOS_BROWSER_URL=derived-from-PROD_HOST
BFF_REDIRECT_URI=derived-from-PROD_HOST
OAUTH_BRIDGE_BROWSER_URL=derived-from-PROD_HOST
