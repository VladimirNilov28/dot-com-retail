# Stripe sandbox keys for `make review` (optional; without them card payment is disabled).
# Copy to .env.stripe (Git-ignored) and paste TEST-MODE keys from
# https://dashboard.stripe.com/test/apikeys . Live keys are rejected.
# The webhook signing secret is fetched automatically; leave it empty.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
