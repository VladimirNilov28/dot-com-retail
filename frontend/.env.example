# Server-only; never prefix these with NEXT_PUBLIC_ or add tokens here.
HIVE_GRAPHQL_URL=http://localhost:4002/graphql
# Must also be allowed by Spring and Hive. Use one hostname consistently.
STOREFRONT_ORIGIN=http://127.0.0.1:3000

# Authentication is server-only; anonymous pages do not require these variables.
# Provision/migrate the separate database before using authentication.
AUTH_DATABASE_URL=postgresql://storefront_auth_runtime:replace-with-random-session-database-password@127.0.0.1:5432/storefront_auth
AUTH_OAUTH_ISSUER=http://127.0.0.1:4444
AUTH_KRATOS_URL=http://127.0.0.1:4433
AUTH_BRIDGE_URL=http://127.0.0.1:4446
AUTH_CLIENT_ID=bytecore-storefront
# Must match the server-side BFF_CLIENT_SECRET / AUTH_BRIDGE_SECRET.
AUTH_CLIENT_SECRET=replace-with-independent-random-bff-secret
AUTH_BRIDGE_SECRET=replace-with-independent-random-bridge-secret
# JSON key ring, each value a base64url-encoded random 32-byte key.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SEAL_KEYS={"active":"v1","keys":{"v1":"replace-with-base64url-encoded-32-byte-key"}}
