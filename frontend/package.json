{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "graphql:generate": "bun scripts/generate-graphql.mjs",
    "graphql:check": "bun scripts/generate-graphql.mjs --check",
    "test:graphql": "bun test src/lib/graphql",
    "test:auth": "bun --conditions=react-server test src/lib/auth",
    "auth:maintenance": "bun --conditions=react-server scripts/auth-maintenance.ts",
    "graphql:verify": "bun scripts/verify-hive.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "@ory/client": "1.22.66",
    "@react-aria/ssr": "3.10.1",
    "@react-aria/utils": "3.34.1",
    "altcha": "3.3.0",
    "axios": "1.20.0",
    "axios-cookiejar-support": "7.0.0",
    "graphql": "16.14.2",
    "lossless-json": "4.3.1",
    "jose": "6.2.12",
    "lucide-react": "1.52.0",
    "next": "16.3.6",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tough-cookie": "6.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@graphql-codegen/core": "6.2.1",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@types/node": "^20",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
