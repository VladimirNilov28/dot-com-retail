# Template for the reviewer stack's `.env.review` (git-ignored).
#
# scripts/review-up.sh copies this file to `.env.review` on first run and
# replaces every @hex32@ / @hex16@ / @b64url32@ marker with fresh random
# values generated inside a container. Later runs keep the existing file, so
# secrets and database passwords stay valid for the existing volumes.
# Never commit `.env.review`. See docs/review-setup.md.

# --- Public review origin (all HTTPS through the Caddy edge) ---------------
# Environment variables of the same name override these values.
REVIEW_HOST=bytecore.localhost
REVIEW_STOREFRONT_PORT=8443
REVIEW_KRATOS_PORT=8433
REVIEW_HYDRA_PORT=8444
REVIEW_BRIDGE_PORT=8446
REVIEW_MAILPIT_PORT=8425
# Host interface for the published TLS ports (loopback only by default).
REVIEW_BIND=127.0.0.1
# Internal review network; Spring trusts X-Forwarded-For only from the Hive
# Router's fixed address. Change both together if the subnet collides.
REVIEW_SUBNET=172.28.90.0/24
REVIEW_HIVE_IP=172.28.90.40

# --- Postgres (TLS-only for network clients in the review stack) -----------
DB_USERNAME=retail
DB_PASSWORD=@hex32@

HYDRA_DB_USER=hydra
HYDRA_DB_PASSWORD=@hex32@
HYDRA_DSN=postgres://${HYDRA_DB_USER}:${HYDRA_DB_PASSWORD}@postgres:5432/hydra?sslmode=verify-full&sslrootcert=/review-certs/ca.crt
HYDRA_SYSTEM_SECRET=@hex32@
HYDRA_ADMIN_URL=http://hydra:4445
HYDRA_PUBLIC_URL=http://hydra:4444

KRATOS_DB_USER=kratos
KRATOS_DB_PASSWORD=@hex32@
KRATOS_DSN=postgres://${KRATOS_DB_USER}:${KRATOS_DB_PASSWORD}@postgres:5432/kratos?sslmode=verify-full&sslrootcert=/review-certs/ca.crt
KRATOS_SECRETS_COOKIE=@hex32@
# Kratos requires exactly 32 characters.
KRATOS_SECRETS_CIPHER=@hex16@
KRATOS_ADMIN_URL=http://kratos:4434
KRATOS_PUBLIC_URL=http://kratos:4433
# Required by compose.yml; compose.review.yml sets the HTTPS value actually used.
KRATOS_BROWSER_URL=https://bytecore.localhost:8433

PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=@hex32@
PAYMENT_DB_URL=postgres://${PAYMENT_DB_USER}:${PAYMENT_DB_PASSWORD}@postgres:5432/payment_service?sslmode=verify-full&sslrootcert=/review-certs/ca.crt
PAYMENT_INTERNAL_TOKEN=@hex32@

AUTH_MIGRATION_USER=storefront_auth_migrator
AUTH_MIGRATION_PASSWORD=@hex32@
AUTH_DB_USER=storefront_auth_runtime
AUTH_DB_PASSWORD=@hex32@
CAPTCHA_DB_USER=storefront_captcha_runtime
CAPTCHA_DB_PASSWORD=@hex32@
CAPTCHA_DATABASE_URL=postgres://${CAPTCHA_DB_USER}:${CAPTCHA_DB_PASSWORD}@postgres:5432/storefront_auth?sslmode=verify-full&sslrootcert=/review-certs/ca.crt

# --- Kafka (not a secret; any 22-character base64 id) ----------------------
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Bootstrap administrator ------------------------------------------------
# oauth-service provisions this ADMIN account (email: <username>@bytecore.ee)
# on first start. Keep `admin`: the optional demo catalog seed re-creates the
# same canonical user row. Staff must enroll TOTP at /admin/security first.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=@hex16@

# --- OAuth2 clients and BFF -------------------------------------------------
OAUTH_SERVICE_CLIENT_ID=oauth-service-internal
OAUTH_SERVICE_CLIENT_SECRET=@hex32@
BFF_CLIENT_ID=bytecore-storefront
BFF_CLIENT_SECRET=@hex32@
# Required by compose.yml; compose.review.yml sets the HTTPS values actually used.
BFF_REDIRECT_URI=https://bytecore.localhost:8443/auth/callback
OAUTH_BRIDGE_BROWSER_URL=https://bytecore.localhost:8446
AUTH_BRIDGE_SECRET=@hex32@
CAPTCHA_SECRET=@hex32@
# BFF sealing key ring (base64url-encoded 32-byte keys).
AUTH_SEAL_KEYS='{"active":"v1","keys":{"v1":"@b64url32@"}}'
# Backend encryption-at-rest key ring for addresses, order snapshots and contact messages.
APP_DATA_KEYS=v1:@b64url32@

# --- Optional: Stripe sandbox (test-mode keys only) -------------------------
# Blank keys disable card payments. Easiest: put the keys into .env.stripe (see
# .env.stripe.example); scripts/review-up.sh copies them here, fetches the webhook
# signing secret and starts the stripe-listener container automatically.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Optional: Google sign-in ----------------------------------------------
# Register this redirect URI on the Google OAuth client:
#   https://bytecore.localhost:8443/self-service/methods/oidc/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
