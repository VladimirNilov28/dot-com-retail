# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# Existing local service defaults are retained. Authentication placeholders
# must be replaced with independent private random secrets before startup.
# See docs/auth/browser-contract.md for existing-volume migration and rollout.

# DOCKER CONF
# Superuser credentials for the postgres container itself.
# Keep these identical to DB_USERNAME/DB_PASSWORD below.
POSTGRES_USER=retail
POSTGRES_PASSWORD=retail

# APPLICATION.YAML CONF
# Compose passes DB_USERNAME/DB_PASSWORD to Spring and uses postgres:5432.
# DB_URL remains available for an explicitly configured host/prod run.
DB_URL=jdbc:postgresql://127.0.0.1:5432/retail
DB_USERNAME=retail
DB_PASSWORD=retail

# OAUTH CONF
# Reserved for a future Spring OAuth2 client registration; not yet consumed by any code.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# HYDRA CONF
# HYDRA_DB_USER/PASSWORD provision Hydra's own Postgres role+database on first
# container init (see infrastructure/postgres/init/01-create-hydra.sh).
HYDRA_DB_USER=hydra
HYDRA_DB_PASSWORD=hydra_password
# Must stay in sync with HYDRA_DB_USER/HYDRA_DB_PASSWORD above.
HYDRA_DSN=postgres://hydra:hydra_password@postgres:5432/hydra?sslmode=disable
# Generate a real random secret for anything beyond local dev, e.g.:
#   openssl rand -hex 32
HYDRA_SYSTEM_SECRET=replace-with-long-random-secret
# Internal Docker-network URL the hydra-bootstrap service uses to reach Hydra's Admin API.
HYDRA_ADMIN_URL=http://hydra:4445
# Internal token/authorization endpoint used by oauth-service.
HYDRA_PUBLIC_URL=http://hydra:4444

# KRATOS CONF
# KRATOS_DB_USER/PASSWORD provision Kratos's own Postgres role+database on
# first container init (see infrastructure/postgres/init/02-create-kratos.sh).
KRATOS_DB_USER=kratos
KRATOS_DB_PASSWORD=kratos_password
# Must stay in sync with KRATOS_DB_USER/KRATOS_DB_PASSWORD above.
KRATOS_DSN=postgres://kratos:kratos_password@postgres:5432/kratos?sslmode=disable
# Generate a real random secret for anything beyond local dev, e.g.:
#   openssl rand -hex 32
KRATOS_SECRETS_COOKIE=replace-with-long-random-secret
# Must be EXACTLY 32 characters (Kratos rejects any other length). Generate with:
#   openssl rand -hex 16
KRATOS_SECRETS_CIPHER=replace-with-32-byte-secret12345
# Internal Docker-network URL the oauth-service uses to reach Kratos's Admin API.
KRATOS_ADMIN_URL=http://kratos:4434
# Internal Docker-network URL the oauth-service uses for server-to-server session lookups.
KRATOS_PUBLIC_URL=http://kratos:4433
# Browser-facing URL the oauth-service redirects the user's browser to for login.
KRATOS_BROWSER_URL=http://127.0.0.1:4433

# PAYMENT SERVICE CONF
# PAYMENT_DB_USER/PASSWORD provision the Go Payment Service's own Postgres
# role+database on first container init (see
# infrastructure/postgres/init/03-create-payment-service.sh). The Payment
# Service never connects to the `retail` database, and Spring never
# connects to `payment_service` - inter-service communication is Kafka only.
PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=payment_service_password
# Consumed directly by the payment-service container (internal Docker-network DSN).
PAYMENT_DB_URL=postgres://payment_service:payment_service_password@postgres:5432/payment_service?sslmode=disable

# KAFKA CONF
# Single-node KRaft broker requires a cluster id; any valid 22-character
# base64 string works for local dev. Generate a fresh one with:
#   docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Host-tool address; Compose configures Spring with kafka:29092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# DEV ADMIN IDENTITY CONF
# oauth-service provisions the canonical Spring user (username, derived
# email, ADMIN role) and links a Kratos identity (email + password
# credential) to it on startup if it doesn't already exist yet, for manual
# local testing. Email is derived as ${ADMIN_USERNAME}@bytecore.ee.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-dev-password

# Base URL for a standalone oauth-service run; Compose sets this service
# address explicitly so old host-gateway values in a local .env cannot break it.
SPRING_INTERNAL_BASE_URL=http://backend:8080

# Machine (client_credentials) Hydra client oauth-service authenticates as
# when calling the Spring internal auth API.
OAUTH_SERVICE_CLIENT_ID=oauth-service-internal
OAUTH_SERVICE_CLIENT_SECRET=oauth-service-dev-secret

# Browser BFF contract: docs/auth/browser-contract.md.
# These are placeholders, not shared/dev authentication bypass credentials.
# Generate independent secrets with `openssl rand -hex 32`.
BFF_CLIENT_ID=bytecore-storefront
BFF_CLIENT_SECRET=replace-with-independent-random-bff-secret
BFF_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
AUTH_BRIDGE_SECRET=replace-with-independent-random-bridge-secret
CAPTCHA_SECRET=replace-with-independent-random-captcha-secret
OAUTH_BRIDGE_BROWSER_URL=http://127.0.0.1:4446

# Separate durable BFF/CAPTCHA database. Existing volumes need the explicit
# documented migration; init scripts run only for a new Postgres volume.
AUTH_MIGRATION_USER=storefront_auth_migrator
AUTH_MIGRATION_PASSWORD=replace-with-random-migration-password
AUTH_DB_USER=storefront_auth_runtime
AUTH_DB_PASSWORD=replace-with-random-session-database-password
CAPTCHA_DB_USER=storefront_captcha_runtime
CAPTCHA_DB_PASSWORD=replace-with-random-captcha-database-password
CAPTCHA_DATABASE_URL=postgresql://storefront_captcha_runtime:replace-with-random-captcha-database-password@postgres:5432/storefront_auth
