enum OrderStatus {
  PENDING
  PAID
  SHIPPING
  COMPLETED
  CANCELLED
}

# Shared with User.paymentMethods; keep it here so both domains reference one definition.
enum PaymentMethodType {
  CARD
  BANK_TRANSFER
  DIGITAL_WALLET
  CASH_ON_DELIVERY
}

type Order {
  id: ID!
  publicId: UUID!
  user: User!
  items: [OrderItem!]!
  status: OrderStatus!
  totalAmount: BigDecimal!
  # Only set when status is CANCELLED; distinguishes an automatic
  # payment-failure cancellation from a manual admin cancellation. Null
  # otherwise.
  cancellationReason: String
  createdAt: Instant!
  updatedAt: Instant!
}

type OrderItem {
  id: ID!
  publicId: UUID!
  order: Order!
  productVariant: ProductVariant!
  quantity: Int!
  priceAtPurchase: BigDecimal!
}
