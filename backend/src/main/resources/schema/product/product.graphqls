type Product {
  id: ID!
  name: String!
  slug: String!
  description: String
  """Arithmetic mean of persisted 1-5 star ratings; null when there are no ratings."""
  averageRating: Float
  """Number of distinct authenticated users who rated this product."""
  ratingCount: Int!
  categories: [Category!]!
  variants: [ProductVariant!]!
  createdAt: Instant!
  updatedAt: Instant!
}

type ProductVariant {
  id: ID!
  product: Product!
  sku: String!
  price: BigDecimal!
  attributes: JSON!
  barcode: String
  weightGrams: Int
  isActive: Boolean!
  createdAt: Instant!
  updatedAt: Instant!
}