input CreateProductInput {
  name: String!
  slug: String!
  description: String
  categoryIds: [ID!]
}

input UpdateProductInput {
  name: String
  slug: String
  description: String
  categoryIds: [ID!]
}

input CreateProductVariantInput {
  productId: ID!
  sku: String!
  price: BigDecimal!
  attributes: JSON
  barcode: String
  weightGrams: Int
}

input UpdateProductVariantInput {
  sku: String
  price: BigDecimal
  attributes: JSON
  barcode: String
  weightGrams: Int
  isActive: Boolean
}

extend type Mutation {
  """
  Submit/update the caller's integer 1-5 star rating. Requires rating:write and an
  active canonical account. One rating per user/product; no verified-purchase rule.
  No user ID is accepted, so callers cannot edit another user's rating.
  """
  rateProduct(productId: ID!, stars: Int!): Product!
  createProduct(input: CreateProductInput!): Product!
  updateProduct(productId: ID!, input: UpdateProductInput!): Product!
  deleteProduct(productId: ID!): Boolean!

  createProductVariant(input: CreateProductVariantInput!): ProductVariant!
  updateProductVariant(variantId: ID!, input: UpdateProductVariantInput!): ProductVariant!
  deleteProductVariant(variantId: ID!): Boolean!
}